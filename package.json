{
  "name": "jarvis",
  "version": "1.0.0-alpha.0",
  "description": "JARVIS Generation 2 — deterministic, provider-agnostic engineering runtime: policy, operation-specific approvals, execution gateway, audit.",
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "eslint src tests",
    "ci": "npm run typecheck && npm run lint && npm test && npm run build",
    "format": "prettier --write src tests docs README.md",
    "prepublishOnly": "npm run build",
    "jarvis": "tsx src/cli/main.ts",
    "export-schemas": "tsx scripts/export-schemas.ts"
  },
  "engines": {
    "node": ">=22.5"
  },
  "license": "MIT",
  "keywords": [
    "ai",
    "developer-tools",
    "evidence-first",
    "cursor",
    "cli",
    "typescript",
    "harness"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RikkyRS/Jarvis.git"
  },
  "bugs": {
    "url": "https://github.com/RikkyRS/Jarvis/issues"
  },
  "homepage": "https://github.com/RikkyRS/Jarvis#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@types/node": "^24.3.0",
    "eslint": "^9.33.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.4",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.40.0",
    "vitest": "^5.1.1"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "bin": {
    "jarvis": "./dist/cli/main.js"
  }
}
